APP_ENV=development
MAX_EMAIL_SIZE_MB=20
MAX_ATTACHMENT_COUNT=20
MAX_ATTACHMENT_SIZE_MB=10
DETECTOR_TIMEOUT_SECONDS=15
HASH_LOOKUP_API_URL=https://www.virustotal.com/api/v3
HASH_LOOKUP_API_KEY=
LLM_MODEL=
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1
# 仅当你的 OpenAI 兼容服务支持 response_format=json_object 时才设为 1；
